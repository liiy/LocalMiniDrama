# Python 运行与字节码缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 环境变量与敏感密钥文件（保护 API Key 与主密钥）
.env
.env.local
.env.*.local
!.env.example
.lmd_master_key
data/.lmd_master_key

# 运行时数据与媒体存储
data/storage/
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite*
data/drama_memory/

# 测试、代码检查与覆盖率缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# 构建与打包输出
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
MANIFEST

# 日志与调试临时文件
*.log
*.err
*.out
uvicorn.err
diff_*.txt
_dbg_*.py

# 编辑器与系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/
