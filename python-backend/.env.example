# LocalMiniDrama Python 服务环境变量示例
# 复制为 .env 后按环境修改。不要向仓库提交真实密码、令牌或生产连接地址。

# 应用与服务
LMD_CONFIG_PATH=configs/config.yaml
LMD_APP_NAME=LocalMiniDrama Python Backend
LMD_APP_VERSION=1.0.0
LMD_LANGUAGE=zh
LMD_DEBUG=false
LMD_HOST=0.0.0.0
LMD_PORT=5679
LMD_SERVER_READ_TIMEOUT=300
LMD_SERVER_WRITE_TIMEOUT=300
LMD_CORS_ORIGINS=http://127.0.0.1:3013,http://localhost:3013

# MySQL：应用库与验收库必须隔离
LMD_DATABASE_TYPE=mysql
LMD_DATABASE_HOST=127.0.0.1
LMD_DATABASE_PORT=3306
LMD_DATABASE_NAME=drama_genertor
LMD_DATABASE_USER=lmd
LMD_DATABASE_PASSWORD=change_me
LMD_DATABASE_CHARSET=utf8mb4
LMD_DATABASE_TIMEZONE=+08:00
LMD_DATABASE_POOL_SIZE=10
LMD_DATABASE_MAX_OVERFLOW=20
LMD_DATABASE_POOL_TIMEOUT_SECONDS=30
LMD_DATABASE_POOL_RECYCLE_SECONDS=1200
LMD_DATABASE_CONNECT_TIMEOUT_SECONDS=10
LMD_DATABASE_URL=mysql+pymysql://lmd:change_me@127.0.0.1:3306/drama_genertor?charset=utf8mb4
LMD_TEST_DATABASE_URL=mysql+pymysql://lmd:change_me@127.0.0.1:3306/drama_genertor_test?charset=utf8mb4

# 本地存储与视频任务
LMD_STORAGE_TYPE=local
LMD_STORAGE_LOCAL_PATH=storage
LMD_STORAGE_BASE_URL=/static
LMD_VIDEO_GENERATION_TIMEOUT_MINUTES=30

# 默认 AI 能力与生成样式
LMD_DEFAULT_TEXT_PROVIDER=deepseek
LMD_DEFAULT_IMAGE_PROVIDER=
LMD_DEFAULT_VIDEO_PROVIDER=
LMD_DEFAULT_STYLE=
LMD_DEFAULT_ROLE_STYLE=真人写实
LMD_DEFAULT_SCENE_STYLE=真人写实
LMD_DEFAULT_PROP_STYLE=真人写实
LMD_DEFAULT_IMAGE_RATIO=9:16
LMD_DEFAULT_VIDEO_RATIO=9:16
LMD_DEFAULT_PROP_RATIO=1:1
LMD_DEFAULT_IMAGE_SIZE=2K

# 厂商锁定配置
LMD_VENDOR_LOCK_ENABLED=false
LMD_VENDOR_CONFIG_FILE=configs/model_ark.yaml

# 队列与独立 Worker
LMD_QUEUE_BACKEND=dramatiq
LMD_REDIS_URL=redis://127.0.0.1:6379/0
LMD_QUEUE_WORKER_ENABLED=false
LMD_QUEUE_WORKER_ID=
LMD_QUEUE_WORKER_QUEUES=default,image,video,audio,workflow
LMD_QUEUE_AUTO_ADVANCE=true
LMD_QUEUE_POLL_SECONDS=1
LMD_QUEUE_HEARTBEAT_SECONDS=10
LMD_QUEUE_RECOVERY_SECONDS=30
LMD_QUEUE_WAITING_SYNC_SECONDS=5
LMD_QUEUE_STALE_WORKER_SECONDS=60
LMD_QUEUE_STALE_JOB_SECONDS=900

# 安全、上传与密钥加密
LMD_MASTER_KEY=replace_with_32_byte_urlsafe_base64_key
LMD_MASTER_KEY_FILE=data/.lmd_master_key
LMD_AUTH_ENABLED=false
LMD_API_TOKEN=
LMD_RATE_LIMIT_PER_MINUTE=120
LMD_MAX_IMAGE_BYTES=20971520
LMD_MAX_AUDIO_BYTES=52428800
LMD_MAX_ZIP_BYTES=209715200
LMD_MAX_TEXT_BYTES=10485760

# 图片代理
LMD_IMAGE_PROXY_USE_FOR_VIDEO=false
LMD_IMAGE_PROXY_EXPIRE_HOURS=24
LMD_IMAGE_PROXY_UPLOAD_TIMEOUT_SECONDS=30
LMD_IMAGE_PROXY_UPLOAD_MAX_ATTEMPTS=3

# 长期记忆向量库
LMD_VECTOR_MEMORY_BACKEND=disabled
LMD_QDRANT_URL=http://127.0.0.1:6333
LMD_QDRANT_API_KEY=
LMD_VECTOR_MEMORY_COLLECTION=lmd_memories
LMD_VECTOR_SIZE=1536
LMD_VECTOR_DISTANCE=Cosine
LMD_VECTOR_ISOLATE_BY_DRAMA=true

# 可观测性与模型厂商密钥（按需启用）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ARK_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
